# ---------- 链上配置 ----------
# 目标链 ID：11155111 = Sepolia，1 = Mainnet，31337 = 本地 Hardhat/Anvil
NEXT_PUBLIC_CHAIN_ID=11155111

NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# PredictionMarket 合约地址（部署后填入）
NEXT_PUBLIC_PREDICTION_MARKET_ADDRESS=0x0000000000000000000000000000000000000000

# ---------- 钱包 ----------
# WalletConnect Cloud projectId，https://cloud.walletconnect.com 免费申请
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ---------- 实时通道 ----------
# 留空则使用内置 Mock 数据源（无需后端即可跑通全流程）
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_LIVE_STREAM_URL=

# 直播渲染帧率上限（性能演示用，默认 24）
NEXT_PUBLIC_LIVE_TARGET_FPS=24
